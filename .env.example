# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
# For local development, run `npm run setup` to auto-generate .env.local
# with the correct values from the local Supabase instance.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Server-only — used by scripts, seeders and admin mutations.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Stellar hash anchoring (optional — only needed if using Stellar attestation)
# STELLAR_SECRET_KEY=<your-stellar-secret-key>
# STELLAR_NETWORK=testnet   # or "mainnet" / "public"
# NEXT_PUBLIC_STELLAR_NETWORK=testnet   # controls stellar.expert explorer links (testnet | mainnet | public)
